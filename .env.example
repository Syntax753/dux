# How LLM calls are routed:
#   live (default) — shells out to the `claude` CLI; uses your local Claude account, no API key needed
#   mock           — deterministic stub responses (for tests)
#   api            — direct fetch to api.anthropic.com (requires ANTHROPIC_API_KEY below)
VITE_AI_MODE=live

# Only needed when VITE_AI_MODE=api
# ANTHROPIC_API_KEY=your-api-key-here
